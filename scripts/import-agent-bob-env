#!/usr/bin/env python3
"""Copy the values Bob can reuse from agent-bob's .env into this repo's .env.

    scripts/import-agent-bob-env [path/to/agent-bob/.env]

Values are never printed. Re-running overwrites the imported keys and keeps anything else
you have added to .env by hand. Keys agent-bob needed and Bob does not (snapshots, registry,
blob backend, mock-model settings, the project map's connections) are left behind on purpose.
"""
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SRC = Path(sys.argv[1] if len(sys.argv) > 1 else ROOT.parent / "agent-bob" / ".env")
DST = ROOT / ".env"

# agent-bob name → Bob name
RENAMES = {
    "CLAUDE_CODE_OAUTH_TOKEN": "CLAUDE_CODE_OAUTH_TOKEN",  # Claude on Kai's subscription
    "ANTHROPIC_API_KEY": "ANTHROPIC_API_KEY",              # Claude on metered billing (not passed by default)
    "OPENAI_API_KEY": "OPENAI_API_KEY",                    # Codex / OpenCode on metered billing (M2)
    "ENC_GITHUB_TOKEN": "GITHUB_TOKEN",                    # clones project config repos
    "GOOGLE_CLIENT_ID": "GOOGLE_CLIENT_ID",                # Google login + Drive/Gmail connect (M3/M5)
    "GOOGLE_CLIENT_SECRET": "GOOGLE_CLIENT_SECRET",
    "AGENTKIT_JWT_SECRET": "BOB_SESSION_SECRET",           # signs login sessions (M3)
    "GCP_PROJECT": "GCP_PROJECT",                          # files MCP bucket (M4)
    "GCP_REGION": "GCP_REGION",
    "GCS_BUCKET": "GCS_BUCKET",
    "FRED_API_KEY": "FRED_API_KEY",                        # Wolf
}

# Bob's own settings, written only if .env does not already set them.
DEFAULTS = {
    "BOB_DATABASE_URL": "postgres://bob:bob@127.0.0.1:5433/bob",
    "BOB_RUNTIME_IMAGE": "bob-runtime:dev",
    # Claude prefers ANTHROPIC_API_KEY over CLAUDE_CODE_OAUTH_TOKEN when both are present,
    # so only the subscription token is passed. Swap it for ANTHROPIC_API_KEY to use billing.
    "BOB_PASS_ENV": "CLAUDE_CODE_OAUTH_TOKEN,GITHUB_TOKEN",
}


def parse(path):
    out = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        out[key.strip()] = value
    return out


def quote(value):
    return "'" + value.replace("'", "'\\''") + "'"


if not SRC.exists():
    sys.exit(f"no such file: {SRC}")
src = parse(SRC)
existing = parse(DST) if DST.exists() else {}

merged = dict(existing)
imported, missing = [], []
for old, new in RENAMES.items():
    if src.get(old):
        merged[new] = src[old]
        imported.append(new)
    else:
        missing.append(old)
for key, value in DEFAULTS.items():
    merged.setdefault(key, value)

# Who may sign in and which projects they use: agent-bob's project map, users only.
if src.get("AGENTKIT_PROJECT_MAP"):
    try:
        users = json.loads(src["AGENTKIT_PROJECT_MAP"]).get("users", {})
        if users:
            merged["BOB_PROJECT_MAP"] = json.dumps(users, separators=(",", ":"))
            merged.pop("BOB_ALLOWED_EMAILS", None)  # deprecated; the map replaces it
            imported.append("BOB_PROJECT_MAP")
    except ValueError:
        missing.append("AGENTKIT_PROJECT_MAP (not valid JSON)")

lines = [f"# Bob local settings. Git-ignored. Imported from {SRC} by scripts/import-agent-bob-env."]
lines += [f"{k}={quote(v)}" for k, v in merged.items()]
fd = os.open(DST, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    f.write("\n".join(lines) + "\n")
os.chmod(DST, 0o600)

print(f"wrote {DST} (mode 600)")
print("imported:", ", ".join(imported) or "nothing")
if missing:
    print("empty or absent in the source:", ", ".join(missing))
