#!/usr/bin/env bash
#
# ./stack — the local development stack for Bob.
#
#   ./stack build          build the runtime image and install the web app's packages
#   ./stack start          Postgres, the "dev" project container, the API on :8070, the web app on :8080
#     [--attach]             ... and follow the logs here instead of returning
#   ./stack stop           stop the API and the web app (Postgres is shared — it stays up)
#   ./stack restart        stop, then start
#   ./stack status         what is running, which projects exist, schedules on or off
#   ./stack logs [api|web|postgres]   follow a log (default: api and web together)
#   ./stack psql [args]    a psql shell in the local database
#   ./stack sql "SELECT …" run one statement
#   ./stack test           every test: Go (with a throwaway database), runtime, web typecheck
#   ./stack containers     the project containers, with their limits
#   ./stack clean          remove every project container and volume (asks first)
#   ./stack publish        build Bob's two images and push them, tagged with HEAD's sha
#                            (scripts/publish; refuses a dirty tree)
#   ./stack publish-postgres  build and push Bob's Postgres image at the tag pinned in
#                            deploy/compose.yml. Only when deploy/postgres/ changes; refuses to
#                            overwrite a tag that is already published
#   ./stack deploy [<tag>] [--files-only]
#                          no tag: publish HEAD (unless already published), then deploy it — the
#                            everyday one command. With a tag: deploy that published tag (rollback).
#                          deploys to the box ($BOX, default
#                            ubuntu@box.badcode.tv): refuses unless
#                            deploy/compose.yml exists at that tag and .env.box exists here; then
#                            over ssh: writes compose.yml, .env (mode 600, umask 077 + rename) and
#                            release.env to /srv/apps/bob, removes leftover
#                            compose.projects.yml/projects.yaml, ensures the bob-projects network
#                            and each bob-project-* volume the new compose file names, pulls and
#                            brings the box up, and waits on its healthz. --files-only stops
#                            after writing the files: nothing is pulled, started or stopped
#
# Deliberately small. The API and the web app run on the host — Go and Vite both
# rebuild faster there. One container, "dev" (deploy/compose.dev.yml), plays the part the box's
# per-project containers play in production: Bob does not start containers, it only talks to them.
#
# Postgres is Bob's own: the `postgres` service in deploy/compose.dev.yml, the same image
# (deploy/postgres) the box runs, on 127.0.0.1:5432. No other repository is needed. If the old
# shared local Postgres from the ops repository is still running, it holds port 5432 — stop it
# with ops/apps/postgres/dev down.
#
# Settings come from .env, a real file here (deploy/env.example is the template). Logs and
# process ids live in .stack/, which is git-ignored.
set -euo pipefail
cd "$(dirname "$0")"

RUN=.stack
COMPOSE_DEV=deploy/compose.dev.yml
API_LOG="$RUN/api.log"
WEB_LOG="$RUN/web.log"
API_PID="$RUN/api.pid"
WEB_PID="$RUN/web.pid"
API_URL=http://127.0.0.1:8070
WEB_URL=http://localhost:8080

say() { printf '── %s\n' "$*"; }
die() { printf '!! %s\n' "$*" >&2; exit 1; }
running() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }

need_env() { [ -f .env ] || die "no .env — copy deploy/env.example to .env and fill it in"; }

# projects_up brings the "dev" project container up (deploy/compose.dev.yml). The volume is
# created first: it is declared external so that `docker compose down -v` can never delete a
# project's history, and compose will not create an external volume itself.
projects_up() {
  mkdir -p "$RUN"
  docker volume create bob-project-dev >/dev/null
  # --env-file: the compose file names its secrets as ${VAR}; compose would otherwise look for
  # an .env beside it, in deploy/, and quietly substitute empty strings.
  docker compose --env-file ./.env -f "$COMPOSE_DEV" up -d >/dev/null
}

# Bob's own Postgres, from deploy/compose.dev.yml. --env-file for the same reason as projects_up.
dev_compose() { docker compose --env-file ./.env -f "$COMPOSE_DEV" "$@"; }
postgres_up() {
  dev_compose up -d --wait postgres >/dev/null \
    || die "Postgres did not come up: ./stack logs postgres (is another Postgres holding 127.0.0.1:5432?)"
}

case "${1:-}" in

build)
  need_env
  say "runtime image (bob-runtime:dev)"
  (cd runtime && npm ci --silent && docker build -q -t bob-runtime:dev . >/dev/null)
  say "web app packages"
  (cd web && npm ci --silent)
  say "API builds"
  (cd api && go build ./...)
  say "built. Start it with: ./stack start"
  ;;

start)
  need_env
  mkdir -p "$RUN"
  docker image inspect bob-runtime:dev >/dev/null 2>&1 || die "no bob-runtime:dev image — run ./stack build first"
  say "Postgres"
  postgres_up
  say "project containers"
  projects_up
  if running "$API_PID"; then
    say "API already running (pid $(cat "$API_PID"))"
  else
    say "API on $API_URL"
    ( set -a; . ./.env; set +a
      export BOB_PROJECTS=dev BOB_RUNTIME_HOSTS=dev=127.0.0.1:8100
      cd api && exec go run ./cmd/bob ) >"$API_LOG" 2>&1 &
    echo $! >"$API_PID"
  fi
  if running "$WEB_PID"; then
    say "web app already running (pid $(cat "$WEB_PID"))"
  else
    say "web app on $WEB_URL"
    ( cd web && exec npx vite --host 127.0.0.1 ) >"$WEB_LOG" 2>&1 &
    echo $! >"$WEB_PID"
  fi
  for _ in $(seq 1 90); do
    if curl -sf "$API_URL/healthz" >/dev/null && curl -sf "$WEB_URL" >/dev/null; then
      say "ready: open $WEB_URL and sign in with Google"
      [ "${2:-}" = "--attach" ] && exec tail -f "$API_LOG" "$WEB_LOG"
      exit 0
    fi
    running "$API_PID" || { tail -20 "$API_LOG"; die "the API stopped — see $API_LOG"; }
    sleep 1
  done
  die "it did not come up: ./stack logs"
  ;;

stop)
  for pidfile in "$API_PID" "$WEB_PID"; do
    if running "$pidfile"; then
      pid=$(cat "$pidfile")
      say "stopping $(basename "$pidfile" .pid) (pid $pid)"
      # The API and Vite each start children; kill the whole group.
      kill -- "-$(ps -o pgid= "$pid" | tr -d ' ')" 2>/dev/null || kill "$pid" 2>/dev/null || true
    fi
    rm -f "$pidfile"
  done
  # Postgres keeps running, like the project containers: the next start is instant.
  say "Postgres left running (docker compose -f $COMPOSE_DEV stop postgres stops it)"
  say "stopped. Project containers keep running; ./stack containers lists them."
  say "(never run 'docker compose down -v' here: -v deletes volumes, and a project's volume is its chats' worktrees.)"
  ;;

restart)
  "$0" stop
  "$0" start "${2:-}"
  ;;

status)
  running "$API_PID" && say "API: running (pid $(cat "$API_PID"))" || say "API: stopped"
  running "$WEB_PID" && say "web app: running (pid $(cat "$WEB_PID"))" || say "web app: stopped"
  if dev_compose exec -T postgres pg_isready -U postgres >/dev/null 2>&1; then
    say "Postgres: running (Bob's own, 127.0.0.1:5432)"
  else
    say "Postgres: stopped"
  fi
  if curl -sf "$API_URL/healthz" >/dev/null 2>&1; then
    "$0" sql "select name, coalesce(absent_at::text, 'served') from projects order by name" 2>/dev/null | sed 's/^/   project: /'
    "$0" sql "select value from settings where key = 'schedules_paused'" 2>/dev/null \
      | sed 's/^t\(rue\)\{0,1\}$/   schedules: PAUSED (Run now still works)/; s/^f\(alse\)\{0,1\}$/   schedules: running/'
  fi
  "$0" containers
  ;;

logs)
  shift || true
  case "${1:-}" in
    postgres) dev_compose logs -f postgres; exit ;;
    api) exec tail -f "$API_LOG" ;;
    web) exec tail -f "$WEB_LOG" ;;
    *) exec tail -f "$API_LOG" "$WEB_LOG" ;;
  esac
  ;;

psql)
  shift || true
  dev_compose exec -e PGPASSWORD=local postgres psql -U postgres -d bob "$@"; exit
  ;;

sql)
  [ $# -ge 2 ] || die 'usage: ./stack sql "SELECT …"'
  dev_compose exec -T postgres psql -U app_bob -d bob -At -c "$2"; exit
  ;;

test)
  need_env
  postgres_up
  # The superuser, not app_bob: these tests create a throwaway database each, and app_bob
  # deliberately cannot (one database per app is the rule production enforces).
  say "Go (throwaway databases on Bob's local Postgres)"
  (cd api && BOB_TEST_DATABASE_URL=postgres://postgres:local@127.0.0.1:5432/postgres?sslmode=disable go test ./...)
  say "runtime (rebuilt first, so deleted tests stop running and new ones start)"
  (cd runtime && rm -rf dist && npm run build && npm test --silent)
  say "web typecheck"
  (cd web && npx tsc -b)
  say "all green"
  ;;

containers)
  docker ps -a --filter name=bob-project- \
    --format '   container: {{.Names}} · {{.Status}} · {{.Image}}' | sort
  ;;

clean)
  docker ps -aq --filter name=bob-project- | grep -q . || { say "no project containers"; exit 0; }
  "$0" containers
  printf '   remove these containers AND their volumes (chat worktrees and harness state are lost; conversations stay in Postgres)? [y/N] '
  read -r answer
  [ "$answer" = y ] || { say "stopped"; exit 1; }
  docker rm -f $(docker ps -aq --filter name=bob-project-) >/dev/null
  docker volume ls -q --filter name=bob-project- | xargs -r docker volume rm >/dev/null
  say "removed. ./stack start makes them again."
  ;;

publish)
  exec scripts/publish
  ;;

publish-postgres)
  # The laptop's Postgres image (the box uses the shared Postgres since 2026-10-23).
  image="$(awk '/^  postgres:/{f=1} f && /image:/{print $2; exit}' "$COMPOSE_DEV")"
  [ -n "$image" ] || die "no postgres image in $COMPOSE_DEV"
  if docker manifest inspect "$image" >/dev/null 2>&1; then
    die "$image is already published. Pinned tags are never overwritten: bump the -N suffix in $COMPOSE_DEV"
  fi
  say "building $image"
  docker build -t "$image" deploy/postgres
  docker push "$image"
  say "published $image — the laptop's Postgres; ./stack restart picks it up"
  ;;

deploy)
  tag="${2:-}"
  files_only="${3:-}"
  [ "$tag" = --files-only ] && { files_only=$tag; tag=""; }
  [ -z "$files_only" ] || [ "$files_only" = --files-only ] || die "unknown option $files_only"
  BOX="${BOX:-ubuntu@box.badcode.tv}"
  # No tag: ship HEAD. scripts/publish refuses a dirty tree, so the tag always names committed code.
  if [ -z "$tag" ]; then
    tag="$(git rev-parse --short HEAD)"
    if docker manifest inspect "europe-west1-docker.pkg.dev/webkit-servers/bob/api:$tag" >/dev/null 2>&1 \
       && docker manifest inspect "europe-west1-docker.pkg.dev/webkit-servers/bob/runtime:$tag" >/dev/null 2>&1; then
      say "$tag is already published"
    else
      scripts/publish || die "publish failed"
    fi
  fi
  git cat-file -e "$tag:deploy/compose.yml" 2>/dev/null \
    || die "no deploy/compose.yml at $tag — publish it first (./stack publish)"
  [ -f .env.box ] || die "no .env.box here — see README.md (production secrets)"

  say "installing /srv/apps/bob on $BOX"
  ssh "$BOX" 'sudo install -d -m 755 /srv/apps/bob'

  say "compose.yml @ $tag → $BOX:/srv/apps/bob/compose.yml"
  git show "$tag:deploy/compose.yml" | ssh "$BOX" 'sudo tee /srv/apps/bob/compose.yml >/dev/null'

  say ".env.box → $BOX:/srv/apps/bob/.env (600)"
  # umask 077 + write .env.new then rename: no window where a partial or world-readable .env
  # exists (ops/scripts/deploy:34 does the same for every other app on the box).
  ssh "$BOX" "sudo sh -c 'umask 077; cat > /srv/apps/bob/.env.new && mv /srv/apps/bob/.env.new /srv/apps/bob/.env'" < .env.box

  say "TAG=$tag → $BOX:/srv/apps/bob/release.env"
  ssh "$BOX" "echo TAG=$tag | sudo tee /srv/apps/bob/release.env >/dev/null"

  say "removing leftovers (compose.projects.yml, projects.yaml)"
  ssh "$BOX" 'sudo rm -f /srv/apps/bob/compose.projects.yml /srv/apps/bob/projects.yaml'

  say "bob-projects network"
  ssh "$BOX" 'sudo docker network inspect bob-projects >/dev/null 2>&1 || sudo docker network create bob-projects >/dev/null'

  say "project volumes"
  for vol in $(git show "$tag:deploy/compose.yml" \
      | awk '/^volumes:/{f=1;next} f && /^  [A-Za-z0-9_.-]+:/{gsub(":","",$1); print $1}' \
      | grep '^bob-project-'); do
    ssh "$BOX" "sudo docker volume create $vol >/dev/null"
  done

  if [ -n "$files_only" ]; then
    say "files written for $tag; nothing pulled, started or stopped (--files-only)"
    exit 0
  fi

  say "pull + up"
  ssh "$BOX" 'sudo app bob pull --quiet && sudo app bob up -d --remove-orphans'

  say "waiting on healthz"
  ok=
  for _ in $(seq 1 60); do
    ssh "$BOX" 'curl -sf http://127.0.0.1:8100/healthz' >/dev/null 2>&1 && { ok=1; break; }
    sleep 1
  done
  [ -n "$ok" ] || die "it did not come up: ssh $BOX 'sudo app bob logs'"
  say "healthy"

  ssh "$BOX" 'sudo docker ps --filter name=bob-project-'
  say "deployed $tag"
  ;;

*)
  awk 'NR > 2 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"
  ;;
esac
