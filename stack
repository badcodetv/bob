#!/usr/bin/env bash
#
# ./stack — the local development stack for Bob.
#
#   ./stack build          build the runtime image and install the web app's packages
#   ./stack start          Postgres, a container per project, the API on :8090, the web app on :8080
#     [--attach]             ... and follow the logs here instead of returning
#   ./stack stop           stop the API and the web app (Postgres is shared — it stays up)
#   ./stack restart        stop, then start
#   ./stack status         what is running, which projects exist, schedules on or off
#   ./stack logs [api|web|postgres]   follow a log (default: api and web together)
#   ./stack psql [args]    a psql shell in the local database
#   ./stack sql "SELECT …" run one statement
#   ./stack test           every test: Go (with a throwaway database), runtime, web typecheck
#   ./stack containers     the project containers, with their limits
#   ./stack clean          remove every project container and volume (asks first)
#
# Deliberately small. The API and the web app run on the host — Go and Vite both
# rebuild faster there. One container per project runs in Compose: Bob does not
# start containers, it only talks to them.
#
# Postgres is NOT Bob's. It is the one shared local Postgres in the ops repository
# (ops/apps/postgres), built from the same Dockerfile as the box, so a laptop runs
# PostgreSQL 18.6 with production's extensions and tuning. Every project gets its
# own database and role there, exactly as on the box. Set OPS_DIR if ops is not at
# ~/projects/badcode/ops.
#
# The projects are projects.dev.yaml, from which scripts/compose-projects.mjs
# generates .stack/projects.yml. A project there publishes its runtime port on
# 127.0.0.1, because a Bob on the host cannot resolve container names.
#
# Settings come from .env (scripts/import-agent-bob-env writes one). Logs and
# process ids live in .stack/, which is git-ignored.
set -euo pipefail
cd "$(dirname "$0")"

RUN=.stack
PROJECTS=projects.dev.yaml
PROJECTS_YML="$RUN/projects.yml"
API_LOG="$RUN/api.log"
WEB_LOG="$RUN/web.log"
API_PID="$RUN/api.pid"
WEB_PID="$RUN/web.pid"
API_URL=http://127.0.0.1:8090
WEB_URL=http://localhost:8080

say() { printf '── %s\n' "$*"; }
die() { printf '!! %s\n' "$*" >&2; exit 1; }
running() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }

need_env() { [ -f .env ] || die "no .env — run scripts/import-agent-bob-env first"; }

# projects_up regenerates the per-project compose file and brings those containers up. It sets
# HOSTS, which the API needs to reach them on the host. The generated file holds no secret — it
# names them as ${VAR} for compose to resolve from .env. Volumes are created first: they are
# declared external so that `docker compose down -v` can never delete a project's history, and
# compose will not create an external volume itself.
projects_up() {
  [ -f "$PROJECTS" ] || die "no $PROJECTS — it lists the projects this Bob serves"
  mkdir -p "$RUN"
  # The generator needs BOB_RUNTIME_KEY and whatever each project's "pass" list names.
  HOSTS=$(node scripts/compose-projects.mjs "$PROJECTS" "$PROJECTS_YML" --publish-from 8100) \
    || die "could not generate $PROJECTS_YML"
  for name in $(grep -oE '^  bob-project-[a-z0-9-]+:' "$PROJECTS_YML" | tr -d ' :' | sort -u); do
    docker volume create "$name" >/dev/null
  done
  # --env-file: the generated file names its secrets as ${VAR}; compose would otherwise look for
  # an .env beside it, in .stack/, and quietly substitute empty strings.
  docker compose --env-file ./.env -f "$PROJECTS_YML" up -d >/dev/null
}

# The one shared local Postgres lives in the ops repository, because it is shared by every
# project rather than owned by this one — the same reason it is its own app on the box. It is
# built from the box's Dockerfile, so local is PostgreSQL 18.6 with production's extensions.
OPS="${OPS_DIR:-$HOME/projects/badcode/ops}"
PG="$OPS/apps/postgres"
pg() {
  [ -x "$PG/dev" ] || die "no shared Postgres at $PG.
   It lives in the ops repository. Clone it beside this one, or set OPS_DIR=/path/to/ops."
  "$PG/dev" "$@"
}
postgres_up() { pg up >/dev/null || die "Postgres did not come up: ./stack logs postgres"; }

case "${1:-}" in

build)
  need_env
  say "runtime image (bob-runtime:dev)"
  (cd runtime && npm ci --silent && docker build -q -t bob-runtime:dev . >/dev/null)
  say "web app packages"
  (cd web && npm ci --silent)
  say "API builds"
  (cd api && go build ./...)
  say "built. Start it with: ./stack start"
  ;;

start)
  need_env
  mkdir -p "$RUN"
  docker image inspect bob-runtime:dev >/dev/null 2>&1 || die "no bob-runtime:dev image — run ./stack build first"
  say "Postgres"
  postgres_up
  say "project containers"
  projects_up
  if running "$API_PID"; then
    say "API already running (pid $(cat "$API_PID"))"
  else
    say "API on $API_URL"
    ( set -a; . ./.env; set +a
      export BOB_PROJECTS_FILE="$PWD/$PROJECTS" BOB_RUNTIME_HOSTS="$HOSTS"
      cd api && exec go run ./cmd/bob ) >"$API_LOG" 2>&1 &
    echo $! >"$API_PID"
  fi
  if running "$WEB_PID"; then
    say "web app already running (pid $(cat "$WEB_PID"))"
  else
    say "web app on $WEB_URL"
    ( cd web && exec npx vite --host 127.0.0.1 ) >"$WEB_LOG" 2>&1 &
    echo $! >"$WEB_PID"
  fi
  for _ in $(seq 1 90); do
    if curl -sf "$API_URL/healthz" >/dev/null && curl -sf "$WEB_URL" >/dev/null; then
      say "ready: open $WEB_URL and sign in with Google"
      [ "${2:-}" = "--attach" ] && exec tail -f "$API_LOG" "$WEB_LOG"
      exit 0
    fi
    running "$API_PID" || { tail -20 "$API_LOG"; die "the API stopped — see $API_LOG"; }
    sleep 1
  done
  die "it did not come up: ./stack logs"
  ;;

stop)
  for pidfile in "$API_PID" "$WEB_PID"; do
    if running "$pidfile"; then
      pid=$(cat "$pidfile")
      say "stopping $(basename "$pidfile" .pid) (pid $pid)"
      # The API and Vite each start children; kill the whole group.
      kill -- "-$(ps -o pgid= "$pid" | tr -d ' ')" 2>/dev/null || kill "$pid" 2>/dev/null || true
    fi
    rm -f "$pidfile"
  done
  # The shared Postgres is deliberately NOT stopped: other projects use it, and stopping it here
  # would break them. Stop it on purpose with ops/apps/postgres/dev down.
  say "Postgres left running (it is shared — ops/apps/postgres/dev down stops it)"
  say "stopped. Project containers keep running; ./stack containers lists them."
  say "(never run 'docker compose down -v' here: -v deletes volumes, and a project's volume is its chats' worktrees.)"
  ;;

restart)
  "$0" stop
  "$0" start "${2:-}"
  ;;

status)
  running "$API_PID" && say "API: running (pid $(cat "$API_PID"))" || say "API: stopped"
  running "$WEB_PID" && say "web app: running (pid $(cat "$WEB_PID"))" || say "web app: stopped"
  if pg status >/dev/null 2>&1; then
    say "Postgres: running (shared, $PG)"
  else
    say "Postgres: stopped"
  fi
  if curl -sf "$API_URL/healthz" >/dev/null 2>&1; then
    "$0" sql "select name, repo_url, coalesce(absent_at::text, 'served') from projects order by name" 2>/dev/null | sed 's/^/   project: /'
    "$0" sql "select value from settings where key = 'schedules_paused'" 2>/dev/null \
      | sed 's/^t\(rue\)\{0,1\}$/   schedules: PAUSED (Run now still works)/; s/^f\(alse\)\{0,1\}$/   schedules: running/'
  fi
  "$0" containers
  ;;

logs)
  shift || true
  case "${1:-}" in
    postgres) exec docker compose -f "$PG/compose.local.yml" logs -f postgres ;;
    api) exec tail -f "$API_LOG" ;;
    web) exec tail -f "$WEB_LOG" ;;
    *) exec tail -f "$API_LOG" "$WEB_LOG" ;;
  esac
  ;;

psql)
  shift || true
  exec "$PG/dev" psql bob "$@"
  ;;

sql)
  [ $# -ge 2 ] || die 'usage: ./stack sql "SELECT …"'
  exec docker compose -f "$PG/compose.local.yml" exec -T -e PGPASSWORD=local postgres \
    psql -U app_bob -d bob -At -c "$2"
  ;;

test)
  need_env
  postgres_up
  # The superuser, not app_bob: these tests create a throwaway database each, and app_bob
  # deliberately cannot (one database per app is the rule production enforces).
  say "Go (throwaway databases on the shared local Postgres)"
  (cd api && BOB_TEST_DATABASE_URL=postgres://postgres:local@127.0.0.1:5432/postgres?sslmode=disable go test ./...)
  say "runtime"
  (cd runtime && npm test --silent)
  say "web typecheck"
  (cd web && npx tsc -b)
  say "all green"
  ;;

containers)
  docker ps -a --filter name=bob-project- \
    --format '   container: {{.Names}} · {{.Status}} · {{.Image}}' | sort
  ;;

clean)
  docker ps -aq --filter name=bob-project- | grep -q . || { say "no project containers"; exit 0; }
  "$0" containers
  printf '   remove these containers AND their volumes (chat worktrees and harness state are lost; conversations stay in Postgres)? [y/N] '
  read -r answer
  [ "$answer" = y ] || { say "stopped"; exit 1; }
  docker rm -f $(docker ps -aq --filter name=bob-project-) >/dev/null
  docker volume ls -q --filter name=bob-project- | xargs -r docker volume rm >/dev/null
  rm -f "$PROJECTS_YML"
  say "removed. ./stack start makes them again, and each re-clones its repository."
  ;;

*)
  awk 'NR > 2 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"
  ;;
esac
