# Copy to .env (laptop) or .env.box (box). Never commit either — both are gitignored. Every
# variable deploy/compose.yml or deploy/compose.dev.yml names must be set here, with a
# dummy-but-non-empty value, so `docker compose config` can validate the compose file without real
# secrets.

# --- API (deploy/compose.yml; box only) ---
BOB_DATABASE_URL=postgres://user:pass@postgres:5432/bob
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
BOB_SESSION_SECRET=change-me-to-32-plus-random-characters
BOB_PROJECT_MAP={"kai@example.com":["*"]}
BOB_PUBLIC_URL=https://bob.box.badcode.tv
BOB_RUNTIME_TOKEN_ENC=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd

# --- Drive (T14/T16; optional — deploy/compose.yml's api service names these with plain
#     ${VAR} defaults, not `:?required`, so the api starts fine with them empty when a project
#     has no Drive token) ---
# BOB_DRIVE_CLIENT_ID and BOB_DRIVE_CLIENT_SECRET are the "Desktop app" OAuth client Kai creates in
# Google Cloud (required once any BOB_DRIVE_TOKEN_<NAME> below is set). BOB_DRIVE_TOKEN_<NAME> is
# one project's Drive refresh token, minted by `node scripts/drive-token` (<NAME> = the project's
# name, upper-cased, - as _, e.g. BOB_DRIVE_TOKEN_ENC).
BOB_DRIVE_CLIENT_ID=example.apps.googleusercontent.com
BOB_DRIVE_CLIENT_SECRET=example-secret
BOB_DRIVE_TOKEN_ENC=1//0example-refresh-token

# --- bob-project-enc (deploy/compose.yml; box only) ---
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat-example
GITHUB_TOKEN_ENC=ghp_example

# --- bob-project-dev (deploy/compose.dev.yml; laptop only) ---
BOB_RUNTIME_TOKEN_DEV=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd
GITHUB_TOKEN=ghp_example
